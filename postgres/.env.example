# Superuser for the shared postgres cluster that vikunja and meals use.
# Passed to the container via env_file. The image only applies these when it
# initializes an empty data directory.
# Keep this as "postgres": scripts/backup.sh dumps the cluster with -U postgres.
POSTGRES_USER=postgres
# Generate one with: openssl rand -hex 32
POSTGRES_PASSWORD=
# Default database. The healthcheck connects to it, and so do the psql commands
# in meals/.env.example. Don't leave it empty: the image only falls back to
# POSTGRES_USER when initializing, and the healthcheck's `-d $POSTGRES_DB`
# gets no argument, so postgres never goes healthy and vikunja/meals never start.
POSTGRES_DB=postgres
