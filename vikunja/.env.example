# Password for the `vikunja` role in the shared postgres cluster. Compose
# passes it as VIKUNJA_DATABASE_PASSWORD. Generate one with: openssl rand -hex 32
#   docker exec -it postgres bash -c \
#     'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "CREATE USER vikunja WITH PASSWORD '"'"'<value below>'"'"';"'
#   docker exec -it postgres bash -c \
#     'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "CREATE DATABASE vikunja OWNER vikunja;"'
VIKUNJA_DB_PASSWORD=

# Signs login tokens. Changing it logs everyone out.
# Generate one with: openssl rand -hex 32
VIKUNJA_SERVICE_SECRET=

# Gmail login for reminder emails. The address is also the From address.
# Use a Google app password, not the account password. watchtower/.env builds
# its notification URL from these same two values.
VIKUNJA_MAILER_USERNAME=you@example.com
VIKUNJA_MAILER_PASSWORD=
