# LAN IP that traefik binds ports 80/443 to.
TRAEFIK_BIND_IP=192.168.1.10

# Tailnet IP that vikunja (3456), immich-server (2283), grafana (3000) and
# prometheus (9090) bind their ports to. Find it with: tailscale ip -4
TAILSCALE_IP=100.x.x.x

# Email used for Let's Encrypt ACME registration.
ACME_EMAIL=you@example.com

# Public hostnames routed to each service via traefik.
IMMICH_DOMAIN=photos.example.com
VIKUNJA_DOMAIN=tasks.example.com
TALKOMATIC_DOMAIN=chat.example.com
MEALS_DOMAIN=meals.example.com

# Build branches belong here only, never in talkomatic/.env or meals/.env:
# compose prefers this file over an app's own .env, so a copy there is
# silently ignored once this one sets it.

# Branch of bradmartin333/talkomatic-classic to build talkomatic from.
# Defaults to main if unset.
TALKOMATIC_BRANCH=main

# Branch of marco308/meals to build meals from. Defaults to main if unset.
MEALS_BRANCH=main
