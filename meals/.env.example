# Copy to .env, fill in the real password, then run:
#   ./homelab-secrets.sh encrypt
# from the repo root to produce meals/.env.enc for commit.

# Password for the `meals` postgres role. Generate one with: openssl rand -hex 32
#
# Before first `docker compose up`, create the role and database in the
# shared postgres container (see postgres/docker-compose.yml) with this same
# password. POSTGRES_USER/POSTGRES_DB below are already set inside that
# container's own environment (from postgres/.env), so this exec's -U/-d just
# reuse them rather than requiring you to look up the superuser name:
#   docker exec -it postgres bash -c \
#     'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "CREATE USER meals WITH PASSWORD '"'"'<value below>'"'"';"'
#   docker exec -it postgres bash -c \
#     'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "CREATE DATABASE meals OWNER meals;"'
MEALS_DB_PASSWORD=
