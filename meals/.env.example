# Password for the `meals` postgres role. Generate one with: openssl rand -hex 32
#   docker exec -it postgres bash -c \
#     'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "CREATE USER meals WITH PASSWORD '"'"'<value below>'"'"';"'
#   docker exec -it postgres bash -c \
#     'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "CREATE DATABASE meals OWNER meals;"'
MEALS_DB_PASSWORD=
