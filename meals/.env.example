# Password for the `meals` postgres role. Generate one with: openssl rand -hex 32
#   docker exec -it postgres bash -c \
#     'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "CREATE USER meals WITH PASSWORD '"'"'<value below>'"'"';"'
#   docker exec -it postgres bash -c \
#     'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "CREATE DATABASE meals OWNER meals;"'
MEALS_DB_PASSWORD=

# Closes public self-registration once you've created your own household —
# leave unset (defaults to enabled) until you've registered at
# https://<MEALS_DOMAIN>/app, then set this and redeploy so a stranger who
# finds the URL can't spin up a household of their own. Invite family from
# inside the app afterwards (Settings -> invites), not by reopening this.
# REGISTRATION_ENABLED=false
# Optional extra ceiling once registration is closed — this is a
# single-household family server, so 1 refuses a second household outright
# rather than relying on REGISTRATION_ENABLED alone.
# MAX_HOUSEHOLDS=1

# Optional — only used by POST /auth/password-reset; every other feature
# works with this unset. Reuses the same Gmail app password already
# decrypted into vikunja/.env (VIKUNJA_MAILER_USERNAME/PASSWORD) — copy those
# two values in rather than generating a new app password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_START_TLS=true
