# Both are passed to the talkomatic server via env_file (read in the
# talkomatic-classic repo's server.js and server/security.js).

# Signs session cookies. If unset, sessions and validated room access codes are
# lost on every restart. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Guards the /api/v1/rooms endpoints (x-api-key header). Must match
# TALKOMATIC_API_KEY in talkomatic-bot/.env exactly. Generate one with:
# openssl rand -hex 32
TALKOMATIC_API_KEY=
