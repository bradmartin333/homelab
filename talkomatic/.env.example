# Passed to the talkomatic server via env_file (read in the talkomatic-classic
# repo's server.js).

# Signs the chat's session cookies. If unset, everyone's chat identity resets
# on every restart (logins survive either way - they live in accounts.json).
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Bearer token prometheus scrapes /metrics with (monitoring/docker-compose.yml
# reads it from this file too). Unset = the app 404s /metrics.
# Generate one with: openssl rand -hex 32
TALKOMATIC_METRICS_TOKEN=
