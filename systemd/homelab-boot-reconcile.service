[Unit]
Description=Start any homelab container that failed to come up at boot
Wants=network-online.target
# tailscaled: ports bind to the tailnet address, so starting after it usually
# makes boot-reconcile.sh's 60s wait for that address a no-op. Ordering only —
# the wait stays as the real check, since tailscaled can be "started" before
# it has an address.
After=network-online.target docker.service tailscaled.service
Requires=docker.service

[Service]
Type=oneshot
# Explicit, matching homelab-backup.service: a oneshot left `active (exited)`
# is the failure mode that silently stopped backups for five days in Aug 2026.
# Nothing triggers this unit on a timer today, but install.sh treats every
# oneshot in this directory the same way, so keep it inactive after it exits.
RemainAfterExit=no
# Type=oneshot defaults TimeoutStartSec to infinity. This unit runs as part of
# the boot transaction, so a wedged `docker compose up` would hang the boot
# rather than just failing — bound it.
TimeoutStartSec=10min
ExecStart=/opt/homelab/scripts/boot-reconcile.sh

[Install]
WantedBy=multi-user.target
