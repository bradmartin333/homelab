[Unit]
Description=Homelab restic backup (local, array mirror, and B2 offsite)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
# Explicit, even though `no` is the default: an earlier version of this unit set
# RemainAfterExit=yes, which left the service `active (exited)` after every
# successful run. systemd will not recompute a timer's next trigger while the
# unit it triggers is still active, so the timer fired exactly once (2026-08-08)
# and then sat at `Trigger: n/a` for five days. Backups stopped silently.
RemainAfterExit=no
# Type=oneshot defaults TimeoutStartSec to infinity — every other service type
# would give up after 90s. Without this, one hung B2 copy wedges the timer
# forever, which is the same failure as above by a different route. On timeout
# systemd kills the script; the EXIT trap still fires the healthchecks.io /fail
# ping, and the timer reschedules normally. Raise this if a real run ever
# legitimately approaches it.
TimeoutStartSec=4h
# systemd does not set $HOME for root system services (it only populates
# HOME/USER/LOGNAME when User= is given), so restic cannot find its default
# cache location and falls back to running cacheless — re-fetching repo index
# and metadata on every operation. Correct, but on B2 that is egress, the one
# thing the free tier actually bills for; see the cost note in backup.sh.
# CacheDirectory= creates and persists /var/cache/restic with the right
# ownership, which is tidier than pointing HOME at /root.
CacheDirectory=restic
Environment=RESTIC_CACHE_DIR=/var/cache/restic
ExecStart=/opt/homelab/scripts/backup.sh
