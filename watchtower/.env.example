# Shoutrrr smtp:// URL for Watchtower's update-notification emails. Same
# Gmail account/app-password already used in vikunja/.env
# (VIKUNJA_MAILER_USERNAME/PASSWORD) - build the URL from those values.
#
# The username is a full email address, so its "@" must be percent-encoded
# as %40 in the userinfo section (before @smtp.gmail.com); fromAddress and
# toAddresses don't need that encoding since they're query values, not part
# of the URL's authority.
WATCHTOWER_NOTIFICATION_URL=smtp://you%40example.com:change-me@smtp.gmail.com:587/?fromAddress=you@example.com&toAddresses=alerts@example.com
