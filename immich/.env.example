# Postgres role and database for immich. Compose passes these to
# immich-server as DB_*, and to immich-postgres as POSTGRES_*. immich-postgres
# only applies them when it initializes an empty data directory, so changing
# them later won't rename or re-password an existing cluster.
# scripts/backup.sh also reads DB_USERNAME, and falls back to "immich".
DB_USERNAME=immich
DB_DATABASE_NAME=immich
# Generate one with: openssl rand -hex 32
DB_PASSWORD=

# Host path compose mounts as immich-server's upload directory.
# scripts/backup.sh and scripts/pi-verify.sh read it too, to find the library.
UPLOAD_LOCATION=/srv/media/immich
