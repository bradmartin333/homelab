# Read by gickup (written to /tmp/github-token at container start, see
# docker-compose.yml). A fine-grained personal access token:
#   github.com/settings/personal-access-tokens/new
#   Resource owner: bradmartin333, Repository access: All repositories,
#   Permissions: Contents read-only (Metadata read-only comes with it).
# It expires — set a calendar reminder for the date GitHub shows, and rotate
# it here with ./homelab-secrets.sh commit "rotate gickup token".
GITHUB_TOKEN=

# The repos to mirror, by name, comma-separated (no owner prefix). Kept here,
# encrypted, rather than in conf.yml so the list stays out of the public repo.
# healthcheck.sh and sanitycheck.sh read it from here too. Recreate the
# container after editing: docker compose up -d gickup
GICKUP_INCLUDE=
