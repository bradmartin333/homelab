# Copy to .env, fill in the real key, then run:
#   ./homelab-secrets.sh encrypt
# from the repo root to produce talkomatic-bot/.env.enc for commit.

# Required. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional overrides — defaults live in talkomatic-bot/app/index.js
# Only set TALKOMATIC_API_KEY if the talkomatic server has its own
# TALKOMATIC_API_KEY configured (overriding the server's built-in default).
# TALKOMATIC_API_KEY=
# BOT_LOCATION=The Cloud
# ROOM_NAME=Talkomatic
#
# BOT_USERNAME, BOT_PERSONA, REPLY_PERSONA, BOT_TRIGGER_WORDS, and
# CLAUDE_MODEL define the bot's *personality* and are hot-swappable without
# a restart — set them via a drop-in profile in talkomatic-bot/bots/*.env
# instead (see talkomatic-bot/bots/README.md and scripts/bot-ctl.sh), not
# here. They're still read from this file as a fallback if no profile is
# loaded.
# BOT_USERNAME=Mr. Roboto
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# BOT_PERSONA=
# REPLY_PERSONA=
# BOT_TRIGGER_WORDS=Mr. Roboto,Roboto,bot
#
# TYPING_SETTLE_MS=2000
# REPLY_COOLDOWN_MS=2500
#
# Off by default — the bot only replies when a trigger word is used. Set to
# "true" to also let a cheap LLM relevance check earn it unprompted replies.
# LLM_RELEVANCE_CHECK=false
# RELEVANCE_CHECK_COOLDOWN_MS=5000
# The talkomatic server allows only 3 bot-token requests per IP per hour,
# then blocks that IP for an hour. On a 429 the bot waits this long before
# asking again — keep it well above the block window, not below it.
# TOKEN_RATE_LIMIT_RETRY_MS=1200000
# TOKEN_RETRY_BACKOFF_MS=30000
# TOKEN_RETRY_MAX_MS=300000
